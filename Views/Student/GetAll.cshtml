@using System.Collections.Specialized
@{
    ViewData["Title"] = "GetAll";
}

@{
    @* List<Student>? students = ViewBag.Stds as List<Student>; *@
}

@model IEnumerable<Student>

<h1>Get All Students</h1>
<hr />
<a class="btn btn-primary" href="Create">Create New Student</a><br><br>

<table class="table table-striped">
    <tr>
        <th>@Html.DisplayNameFor(s => s.Id)</th>
        <th>@Html.DisplayNameFor(s => s.Name)</th>
        <th>@Html.DisplayNameFor(s => s.Age)</th>
        <th>@Html.DisplayNameFor(s => s.Address)</th>
        <th>@Html.DisplayNameFor(s => s.Department.Name)</th>
        <th>Actions</th>
    </tr>
    @foreach (var std in Model)
    {
        <tr>
            <td>@Html.DisplayFor(s => std.Id)</td>
            <td>@Html.DisplayFor(s => std.Name)</td>
            <td>@Html.DisplayFor(s => std.Age)</td>
            <td>@Html.DisplayFor(s => std.Address)</td>
            <td>@Html.DisplayFor(s => std.Department.Name)</td>
            <td>
                <a class="btn btn-info" asp-action="Details" asp-route-id="@std.Id">Details</a>
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@std.Id">Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@std.Id">Delete</a>
            </td>

        </tr>
    }
</table>