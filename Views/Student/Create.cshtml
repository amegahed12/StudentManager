@{
    ViewData["Title"] = "Create";
    //var depts = ViewBag.Depts as List<Department>;
    var depts = ViewData["Depts"] as List<Department>;
}

@model Student

<h1>Create New Student</h1>

<form asp-action="Create" asp-controller="Student" class="w-25" method="post">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" type="text" class="form-control" id="name" placeholder="Enter Your Name" required>
    </div>

    <br>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" class="form-control" id="email" placeholder="Enter Your Email" required>
    </div>

    <br>

    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" type="number" class="form-control" id="age" placeholder="Enter Your Age" required>
    </div>
    <br>

    <div class="form-group">
        <label asp-for="Address"></label>
        <input asp-for="Address" type="text" class="form-control" id="address" placeholder="Enter Your Address"
               required>
    </div>
    <br>

    <div class="form-group">
        <label asp-for="DeptId"></label>
        <select class="form-control" name="DeptId" id="department">
            @foreach (var dept in depts)
            {
                <option value="@dept.DeptId">@dept.Name</option>
            }
        </select>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="form-control" id="password" placeholder="Create Your Password"
               required>
    </div>

    <br />

    <div class="form-group">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" id="confirm-password"
               placeholder="Confirm Your Password" required>
    </div>

    <br>
    <input type="submit" value="Create" class="btn btn-primary me-4">
    <input type="reset" value="Reset" class="btn btn-warning me-4">
    @* <a class="btn btn-primary" href="../GetAll">Back</a> <br><br> *@


</form>