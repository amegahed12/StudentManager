@{
    ViewData["Title"] = "Details";
}
@model Student

<h1>Studnet Details</h1>
<hr>
@* <a class="btn btn-primary" href="../GetAll">Back</a> <br><br> *@

<table class="table table-striped">
    <thead>
        <th>Feild</th>
        <th>Value</th>
    </thead>
    <tr>
        <td>@Html.DisplayNameFor(s => s.Id)</td>
        <td>@Html.DisplayFor(s => s.Id)</td>
    </tr>
    <tr>
        <td>@Html.DisplayNameFor(s => s.Name)</td>
        <td>@Html.DisplayFor(s => s.Name)</td>
    </tr>
    <tr>
        <td>@Html.DisplayNameFor(s => s.Age)</td>
        <td>@Html.DisplayFor(s => s.Age)</td>
    </tr>
    <tr>
        <td>@Html.DisplayNameFor(s => s.Department.Name)</td>
        <td>@Html.DisplayFor(s => s.Department.Name)</td>
    </tr>
    <tr>
        <td>@Html.DisplayNameFor(s => s.Address)</td>
        <td>@Html.DisplayFor(s => s.Address)</td>
    </tr>

    <tr>
        <td>@Html.DisplayNameFor(s => s.Email)</td>
        <td>@Html.DisplayFor(s => s.Email)</td>
    </tr>

</table>