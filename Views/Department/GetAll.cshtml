@using System.Transactions
@{
    ViewData["Title"] = "GetAll";
}

@model IEnumerable<Department>

<h1>Get All Departments</h1>
<hr>
<a class="btn btn-primary" asp-action="Create" asp-controller="Department">Create New Department</a><br><br>


<table class="table table-striped">
    <tr>
        <th>@Html.DisplayNameFor(s => s.DeptId)</th>
        <th>@Html.DisplayNameFor(s => s.Name)</th>
        <th>@Html.DisplayNameFor(s => s.Students.Count)</th>
        <th>Actions</th>
    </tr>

    @foreach (var dept in Model)
    {
        <tr>
            <td>@Html.DisplayFor(s => dept.DeptId)</td>
            <td>@Html.DisplayFor(s => dept.Name)</td>
            <td>@Html.DisplayFor(s => dept.Students.Count)</td>

            <td>
                <a class="btn btn-info" asp-action="Details" asp-route-id="@dept.DeptId">Details</a>
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@dept.DeptId">Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@dept.DeptId">Delete</a>
            </td>
        </tr>
    }
</table>

