@{
    ViewData["Title"] = "Create";
}

<h1>Create New Department</h1>

<form method="post" action="Create" class="w-25">
    <div class="form-group">
        <label for="name">Name:</label>
        <input type="text" name="Name" class="form-control" id="name" placeholder="Enter Department Name" required>
    </div>

    <br>

    <br>
    <input type="submit" value="Create" class="btn btn-primary me-4">
    <input type="reset" value="Reset" class="btn btn-warning me-4">
    @* <a class="btn btn-primary" href="../GetAll">Back</a> <br><br> *@


</form>