@{
    ViewData["Title"] = "Create";
}
@model Department

<h1>Create New Department</h1>
<form asp-action="Create" asp-controller="Department" class="w-25">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" placeholder="Enter Department Name" required>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <br>

    <br>
    <input type="submit" value="Create" class="btn btn-primary me-4">
    <input type="reset" value="Reset" class="btn btn-warning me-4">
    @* <a class="btn btn-primary" href="../GetAll">Back</a> <br><br> *@


</form>