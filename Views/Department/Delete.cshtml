@{
    ViewData["Title"] = "Delete Department";
}

@model Department

<h1 class="text-danger">Are you sure you want to delete "@Model.Name"?</h1>
<hr />

@if (Model.Students.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        Warning! This department has == @Model.Students.Count student(s) == Deleting this department will also remove these
        students. </div>
    }

    <table class="table table-striped w-50">
        <thead>
            <tr>
                <th>Field</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Html.DisplayNameFor(d => d.DeptId)</td>
                <td>@Html.DisplayFor(d => d.DeptId)</td>
            </tr>
            <tr>
                <td>@Html.DisplayNameFor(d => d.Name)</td>
                <td>@Html.DisplayFor(d => d.Name)</td>
            </tr>
            <tr>
                <td>Students Count</td>
                <td>@Model.Students.Count</td>
            </tr>
        </tbody>
    </table>

    <br />
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="DeptId" />
        <button type="submit" class="btn btn-danger me-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                 class="bi bi-exclamation-triangle-fill me-1" viewBox="0 0 16 16">
                <path
                d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
            </svg>
            Delete
        </button>
        <a class="btn btn-secondary" asp-action="GetAll">Back to List</a>
    </form>