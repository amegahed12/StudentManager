@{
    ViewData["Title"] = "Edit";

}

@model Department

<h1>Edit A Department</h1>
<hr>

<form asp-action="Edit" asp-controller="Department" method="post" class="w-25">
    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" type="text" class="form-control" placeholder="Enter Department Name" required>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <br>

    <br>
    <input type="submit" value="Edit" class="btn btn-primary me-4">
    <input type="reset" value="Reset" class="btn btn-warning me-4">
    @* <a class="btn btn-primary" href="../GetAll">Back</a> <br><br> *@


</form>